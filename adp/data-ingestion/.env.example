APP_ENV=development
# Production deployments must use MySQL, MariaDB, or PostgreSQL.
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://data_ingestion:password@127.0.0.1:5432/data_ingestion
DATABASE_URL=
DATA_DIR=./data
STORAGE_BACKEND=local

# Platform authentication
DATA_INGESTION_AUTH_ENABLED=false
HYDRA_ADMIN_URL=http://127.0.0.1:4445
BKN_SAFE_URL=http://127.0.0.1:3000
DATA_INGESTION_AUTHZ_RESOURCE_TYPE=data_ingestion
DATA_INGESTION_AUTHZ_RESOURCE_ID=platform
DATA_INGESTION_INTERNAL_TOKEN=replace-for-production
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# S3-compatible storage
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=data-ingestion
S3_PREFIX=data-ingestion
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Agent and MCP
DATA_SOURCE_SECRET_KEY=replace-with-a-long-random-secret
MODEL_API_URL=http://127.0.0.1:9898/api/mf-model-api/v1/chat/completions
MODEL_MANAGER_URL=http://127.0.0.1:9898
AGENT_SELF_API_URL=http://127.0.0.1:8000
MCP_API_URL=http://127.0.0.1:8000
MCP_ALLOWED_ROOTS=./data
MCP_AUTH_ENABLED=true
MCP_RESOURCE_URL=http://127.0.0.1:8010
OAUTH_ISSUER_URL=http://127.0.0.1:4444
AUTO_SCAN_ENABLED=true
AUTO_SCAN_TICK_SECONDS=5
AUTO_SCAN_MAX_FILES_PER_RUN=20
MAX_UPLOAD_BYTES=536870912
